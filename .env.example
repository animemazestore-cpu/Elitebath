# =============================================================================
# ELITE BATH COLLECTIONS — ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env and replace the placeholder values with your real keys.

# -----------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION
# -----------------------------------------------------------------------------
# In your Supabase Dashboard: Go to Project Settings -> API
# - VITE_SUPABASE_URL: Project URL (e.g., https://your-project-id.supabase.co)
# - VITE_SUPABASE_ANON_KEY: Public Anon Key (starts with eyJhbGciOi...)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# -----------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY (UPI, Cards, NetBanking, Wallets)
# -----------------------------------------------------------------------------
# In your Razorpay Dashboard: Go to Settings -> API Keys
# Generate test keys for testing or live keys for production.
# - VITE_RAZORPAY_KEY_ID: Public Key ID used on frontend (e.g., rzp_test_...)
# - RAZORPAY_KEY_ID: Key ID for backend / edge serverless order creation
# - RAZORPAY_KEY_SECRET: Key Secret for HMAC SHA-256 server-side signature verification
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
